# Track CargoSquad/Assets, Packages, ProjectSettings, and their .meta files.
# Unity-generated directories
/CargoSquad/[Ll]ibrary/
/CargoSquad/[Tt]emp/
/CargoSquad/[Oo]bj/
/CargoSquad/[Ll]ogs/
/CargoSquad/[Bb]uild/
/CargoSquad/[Bb]uilds/
/CargoSquad/[Uu]ser[Ss]ettings/
/CargoSquad/[Mm]emoryCaptures/
/CargoSquad/[Rr]ecordings/

# Addressables build output, when generated.
/CargoSquad/[Aa]ssets/StreamingAssets/aa/
/CargoSquad/[Aa]ssets/StreamingAssets/aa.meta

# Generated IDE files
/.vs/
/CargoSquad/.vs/
/CargoSquad/.idea/
/CargoSquad/.gradle/
/CargoSquad/ExportedObj/
/CargoSquad/*.csproj
/CargoSquad/*.sln
/CargoSquad/*.slnx
/CargoSquad/*.suo
/CargoSquad/*.user
/CargoSquad/*.userprefs
/CargoSquad/*.pidb
/CargoSquad/*.booproj
/CargoSquad/*.unityproj

# Crash reports and OS metadata
/CargoSquad/sysinfo.txt
/CargoSquad/mono_crash.*
.DS_Store
Thumbs.db

# Local art backups and Python bytecode
/ArtSource/Backups/

# Dire Wolf Lite source download and standalone derivatives. Keep these local.
/ArtSource/External/Dire_Wolf_Lite_v1.0.0/
/ArtSource/External/Dire_Wolf_Lite_v1.0.0.meta
/ArtSource/Characters/Creatures/old/MutatedWolf_Redesign_v1.*
/ArtSource/Characters/Creatures/MutatedWolf_Redesign_v2.*
# Store any extracted meshes, textures, or later exports from Dire Wolf Lite here.
/ArtSource/Private/DireWolfLite/

*.blend[0-9]*
__pycache__/
*.py[cod]
